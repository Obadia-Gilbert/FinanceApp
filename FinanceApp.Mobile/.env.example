# Copy to .env. EXPO_PUBLIC_* is inlined at bundle time — restart Expo after changes:
#   npx expo start -c
#
# Full Google/Facebook setup: FinanceApp.Documentations/MOBILE_AUTH.md
#
# When you change Wi‑Fi, set your Mac's LAN IP so Expo Go can reach Metro (avoids request timed out):
#   ipconfig getifaddr en0
#   REACT_NATIVE_PACKAGER_HOSTNAME=<that IP>
#
# FinanceApp.API ports (see Properties/launchSettings.json):
#   • `http` profile   → http://127.0.0.1:5022  (default; binds localhost only)
#   • `Mobile` profile → http://0.0.0.0:5279   (LAN + simulator; use when testing a physical device)
#
# Port 5279 is also used by FinanceApp.Web (MVC). Do NOT point mobile at Web — you need FinanceApp.API
# or all /api/auth/... calls fail (404 / network errors).
#
# iOS Simulator (on Mac — use loopback + API port):
#   dotnet run --project FinanceApp.API --launch-profile http
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:5022
#
# Physical device (same Wi‑Fi; run API with Mobile profile so it listens on LAN):
#   dotnet run --project FinanceApp.API --launch-profile Mobile
#   EXPO_PUBLIC_API_URL=http://YOUR_MAC_LAN_IP:5279
#
# Android Emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5022
#
EXPO_PUBLIC_API_URL=http://127.0.0.1:5022
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100

# --- Google Sign-In (Google Cloud Console → APIs & Services → Credentials) ---
# Create three OAuth 2.0 client IDs (same project as your OAuth consent screen):
#   • Web application     → paste into EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (and API user secrets)
#   • iOS (bundle com.financeapp.mobile) → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (required for native iOS dev builds)
#   • Android (package com.financeapp.mobile + debug SHA-1) → EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
# Optional: your Expo account name (expo whoami) so Google redirect uses https://auth.expo.io/@YOU/financeapp-mobile
# EXPO_PUBLIC_EXPO_OWNER=your-expo-username
#
# Expo Go on iOS: set BOTH Web + iOS client IDs below — the app uses the iOS client + reversed URL scheme
# (no auth.expo.io redirect needed). auth.expo.io is only a fallback if iOS client ID is missing.
# Reliable sign-in: npx expo run:ios (native Google SDK)
# Dev build (iOS): Web + iOS client IDs, then rebuild the dev client (app.config.js reads iOS ID at prebuild).
# API: dotnet user-secrets set Authentication:Google:* — see MOBILE_AUTH.md §3.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Facebook Login (developers.facebook.com → App ID) ---
# Must match FinanceApp.Web Authentication:Facebook:AppId; API uses AppSecret via user secrets.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# --- In-app subscriptions (App Store Connect / Google Play Console) ---
EXPO_PUBLIC_IAP_IOS_PRO=com.financeapp.mobile.pro.monthly
EXPO_PUBLIC_IAP_IOS_PREMIUM=com.financeapp.mobile.premium.monthly
EXPO_PUBLIC_IAP_ANDROID_PRO=pro_monthly
EXPO_PUBLIC_IAP_ANDROID_PREMIUM=premium_monthly
