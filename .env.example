# Production secrets for docker-compose.yml. Copy to `.env` on the VPS (chmod 600),
# fill in real values, and NEVER commit the filled-in version.
# Full key reference: FinanceApp.Documentations/GOING_LIVE.md#configuration-reference

# --- Database ---
SA_PASSWORD=
ConnectionStrings__DefaultConnection=Server=db,1433;Database=FinanceApp;User Id=sa;Password=REPLACE_WITH_SA_PASSWORD;TrustServerCertificate=true;

# --- JWT (API) — generate with: openssl rand -base64 48 ---
Jwt__Key=
Jwt__Issuer=FinanceApp.API
Jwt__Audience=FinanceApp

# --- Background jobs: exactly ONE of these should be true. docker-compose.yml maps
# these onto each container's own Jobs__Enabled, since both containers load this same
# .env file and a single shared value can't put the jobs on only one of them. ---
API_JOBS_ENABLED=true
WEB_JOBS_ENABLED=false

# --- CORS ---
Cors__AllowedOrigins__0=https://app.yourdomain.com

# --- Email (Brevo HTTP API — avoids blocked SMTP ports) ---
Brevo__ApiKey=
Brevo__SenderEmail=
Brevo__SenderName=FinanceApp

# --- Public URLs ---
PasswordReset__WebAppBaseUrl=https://app.yourdomain.com
EmailBranding__WebAppBaseUrl=https://app.yourdomain.com

# --- OAuth (optional — leave blank to disable a provider) ---
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=

# --- Billing / IAP (optional) ---
SubscriptionBilling__Stripe__SecretKey=
SubscriptionBilling__Stripe__WebhookSecret=

# --- Admin seed (created on first boot if absent) ---
AdminSeed__Email=
AdminSeed__Password=

# --- Caddy virtual hosts ---
WEB_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com

# --- Image tags (set by CD; leave as :local for a manual build) ---
API_IMAGE=financeapp-api:local
WEB_IMAGE=financeapp-web:local
