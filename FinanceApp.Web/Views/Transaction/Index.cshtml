@model IEnumerable<FinanceApp.Web.Models.TransactionViewModel>
@using System.Text.Json
@using FinanceApp.Domain.Enums
@{
    ViewData["Title"] = L["Tx_PageTitle"].Value;
    ViewData["PageDescription"] = L["Tx_Subtitle"].Value;
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    var jsTxFail = JsonSerializer.Serialize(L["Tx_FailedLoadForm"].Value);
    var jsTxDelConfirm = JsonSerializer.Serialize(L["Tx_DeleteConfirm"].Value);
    string TxTypeLabel(TransactionType t) => t switch
    {
        TransactionType.Income => L["Tx_TypeIncome"].Value,
        TransactionType.Expense => L["Tx_TypeExpense"].Value,
        TransactionType.Transfer => L["Tx_BadgeTransfer"].Value,
        _ => t.ToString()
    };
}

@section PageActions {
    <button id="btnAddTransaction" class="btn btn-primary" type="button">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Tx_Add"]
    </button>
    <button id="btnTransfer" class="btn btn-outline-secondary" type="button">
        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> @L["Tx_Transfer"]
    </button>
}

<div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="txOffcanvas" aria-labelledby="txOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 id="txOffcanvasLabel">@L["Tx_OffcanvasTitle"]</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@L["Common_Close"]"></button>
        </div>
        <div class="offcanvas-body px-0">
            <div class="p-3 d-flex align-items-center justify-content-center min-vh-25" id="txOffcanvasContent">
                <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@L["Common_Loading"]</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state__icon"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span>
                <h2 class="empty-state__title">@L["Tx_EmptyPart1"]</h2>
                <p class="empty-state__desc">@L["Tx_EmptyPart2"]</p>
                <button id="btnAddTransactionEmpty" class="btn btn-primary empty-state__action" type="button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Tx_Add"]
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="txTable" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@L["Table_Date"]</th>
                            <th scope="col">@L["Tx_ColAccount"]</th>
                            <th scope="col">@L["Tx_ColType"]</th>
                            <th scope="col">@L["Lbl_Category"]</th>
                            <th scope="col">@L["Tx_ColNote"]</th>
                            <th scope="col" class="col-numeric">@L["Table_Amount"]</th>
                            <th scope="col" class="col-actions"><span class="visually-hidden">@L["Table_Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model)
                        {
                            var typeClass = tx.Type == FinanceApp.Domain.Enums.TransactionType.Income ? "text-success" : tx.Type == FinanceApp.Domain.Enums.TransactionType.Expense ? "text-danger" : "text-info";
                            var typeIcon = tx.Type == FinanceApp.Domain.Enums.TransactionType.Income ? "bi-arrow-down-circle" : tx.Type == FinanceApp.Domain.Enums.TransactionType.Expense ? "bi-arrow-up-circle" : "bi-arrow-left-right";
                            var sign = tx.Type == FinanceApp.Domain.Enums.TransactionType.Income ? "+" : tx.Type == FinanceApp.Domain.Enums.TransactionType.Expense ? "−" : "⇄";
                            <tr>
                                <td class="text-nowrap text-muted" style="font-size: var(--text-sm);">@tx.Date.ToString("d MMM yyyy")</td>
                                <td>@tx.AccountName</td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1 @typeClass" style="font-size: var(--text-sm);">
                                        <i class="bi @typeIcon" aria-hidden="true"></i>@TxTypeLabel(tx.Type)
                                    </span>
                                    @if (tx.IsRecurring)
                                    {
                                        <span class="badge bg-secondary ms-1" title="@L["Nav_Recurring"]"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span class="visually-hidden">@L["Nav_Recurring"]</span></span>
                                    }
                                </td>
                                <td>@(tx.CategoryName ?? "—")</td>
                                <td class="text-truncate" style="max-width:180px;" title="@tx.Note">@(tx.Note ?? "—")</td>
                                <td class="col-numeric">
                                    <span class="amount @(tx.Type == FinanceApp.Domain.Enums.TransactionType.Income ? "amount--positive" : "")">
                                        @sign@tx.Amount.ToString("N2")<span class="amount__code">@tx.Currency</span>
                                    </span>
                                </td>
                                <td class="col-actions">
                                    @if (!tx.TransferGroupId.HasValue)
                                    {
                                        <span class="row-actions">
                                            <a href="@Url.Action("Edit", "Transaction", new { id = tx.Id })" class="icon-btn btn-edit" title="@L["Common_Edit"]" aria-label="@L["Common_Edit"]">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>
                                            <form method="post" asp-action="Delete" asp-controller="Transaction" asp-route-id="@tx.Id" style="display:inline" onsubmit="return confirm(@Html.Raw(jsTxDelConfirm));">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="icon-btn icon-btn--danger" title="@L["Common_Delete"]" aria-label="@L["Common_Delete"]">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </span>
                                    }
                                    else
                                    {
                                        @* Transfers are a paired record — editing one side alone would
                                           break the pair, so they are managed from the transfer flow. *@
                                        <span class="badge bg-info">@L["Tx_BadgeTransfer"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="@L["Tx_PaginationAria"]">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)">@L["Tx_Prev"]</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == pageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@p">@p</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)">@L["Tx_Next"]</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    <script>
        (function () {
            const offcanvasEl = document.getElementById('txOffcanvas');
            const content = document.getElementById('txOffcanvasContent');

            async function loadIntoOffcanvas(url) {
                content.innerHTML = '<div class="text-center text-muted p-4"><span class="spinner-border spinner-border-sm me-2"></span>' + @Html.Raw(JsonSerializer.Serialize(L["Common_Loading"].Value)) + '</div>';
                bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl).show();
                const res = await fetch(url, { credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) { if (typeof showToast === 'function') showToast(@Html.Raw(jsTxFail)); return; }
                content.innerHTML = await res.text();
            }

            const openCreateTx = () => loadIntoOffcanvas('@Url.Action("Create", "Transaction")?partial=true');
            document.getElementById('btnAddTransaction')?.addEventListener('click', openCreateTx);
            document.getElementById('btnAddTransactionEmpty')?.addEventListener('click', openCreateTx);

            document.getElementById('btnTransfer')?.addEventListener('click', () =>
                loadIntoOffcanvas('@Url.Action("Transfer", "Transaction")?partial=true'));

            document.getElementById('txTable')?.addEventListener('click', async function (e) {
                const editBtn = e.target.closest('.btn-edit');
                if (editBtn) {
                    e.preventDefault();
                    const href = editBtn.getAttribute('href');
                    if (href) await loadIntoOffcanvas(href + (href.includes('?') ? '&' : '?') + 'partial=true');
                }
            });

            offcanvasEl?.addEventListener('submit', async function (e) {
                const form = e.target.closest('form');
                if (!form || !offcanvasEl.contains(form)) return;
                e.preventDefault();
                const data = new FormData(form);
                const res = await fetch(form.action, { method: 'POST', body: data, credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const json = await res.json().catch(() => null);
                if (json?.success) {
                    bootstrap.Offcanvas.getInstance(offcanvasEl)?.hide();
                    location.reload();
                } else {
                    const html = await res.text().catch(() => null);
                    if (html) content.innerHTML = html;
                }
            });
        })();
    </script>
}
