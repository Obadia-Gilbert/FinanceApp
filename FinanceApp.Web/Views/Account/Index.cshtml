@using System.Text.Json
@model IEnumerable<FinanceApp.Web.Models.AccountViewModel>

@{
    ViewData["Title"] = L["Acc_PageTitle"].Value;
    ViewData["PageDescription"] = L["Acc_Subtitle"].Value;
    var jsLoading = JsonSerializer.Serialize(L["Common_Loading"].Value);
    var jsFailedLoad = JsonSerializer.Serialize(L["Acc_FailedLoadForm"].Value);
}

@section PageActions {
    <button id="btnAddAccount" class="btn btn-primary" type="button">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Acc_Add"]
    </button>
}

<div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="accountOffcanvas" aria-labelledby="accountOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 id="accountOffcanvasLabel">@L["Acc_OffcanvasTitle"]</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@L["Common_Close"]"></button>
        </div>
        <div class="offcanvas-body px-0">
            <div class="p-3 d-flex align-items-center justify-content-center min-vh-25" id="accountOffcanvasContent">
                <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@L["Common_Loading"]</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state__icon"><i class="bi bi-bank" aria-hidden="true"></i></span>
                <h2 class="empty-state__title">@L["Acc_EmptyPart1"]</h2>
                <p class="empty-state__desc">@L["Acc_EmptyPart2"]</p>
                <button id="btnAddAccountEmpty" class="btn btn-primary empty-state__action" type="button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Acc_Add"]
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4" id="accountCardsRow">
        @foreach (var account in Model.Where(a => a.IsActive))
        {
            var typeIcon = account.Type switch
            {
                FinanceApp.Domain.Enums.AccountType.Savings => "bi-piggy-bank",
                FinanceApp.Domain.Enums.AccountType.Investment => "bi-graph-up-arrow",
                FinanceApp.Domain.Enums.AccountType.CreditCard => "bi-credit-card",
                FinanceApp.Domain.Enums.AccountType.Cash => "bi-cash-stack",
                _ => "bi-bank"
            };
            var balanceClass = account.CurrentBalance >= 0 ? "amount--positive" : "amount--negative";
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="dashboard-kpi-icon rounded-2"><i class="bi @typeIcon" aria-hidden="true"></i></span>
                            <div class="min-w-0">
                                <h3 class="card-title text-truncate">@account.Name</h3>
                                <span class="text-muted" style="font-size: var(--text-xs);">@AccountDisplayHelper.LocalizedAccountType(L, account.Type)</span>
                            </div>
                        </div>
                        <p class="amount @balanceClass mb-1" style="font-size: var(--text-md);">
                            @account.CurrentBalance.ToString("N2")<span class="amount__code">@account.Currency</span>
                        </p>
                        @if (!string.IsNullOrEmpty(account.Description))
                        {
                            <p class="text-muted mb-2" style="font-size: var(--text-sm);">@account.Description</p>
                        }
                        <div class="d-flex gap-2 mt-auto pt-2">
                            <a href="@Url.Action("Edit", "Account", new { id = account.Id })" class="btn btn-outline-secondary btn-sm btn-edit">
                                <i class="bi bi-pencil" aria-hidden="true"></i> @L["Acc_Edit"]
                            </a>
                            <form method="post" asp-action="Delete" asp-route-id="@account.Id" onsubmit="return confirm(@JsonSerializer.Serialize(L["Acc_DeactivateConfirm", account.Name ?? ""].Value));">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-archive" aria-hidden="true"></i> @L["Acc_Deactivate"]
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Any(a => !a.IsActive))
    {
        <details class="mb-3">
            <summary class="text-muted mb-2" style="font-size: var(--text-sm); cursor: pointer;">@L["Acc_InactiveSummary", Model.Count(a => !a.IsActive)]</summary>
            <div class="row g-3 mt-1">
                @foreach (var account in Model.Where(a => !a.IsActive))
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100" style="opacity: 0.7;">
                            <div class="card-body">
                                <h3 class="card-title text-muted">@account.Name <span class="badge bg-secondary ms-1">@L["Acc_InactiveBadge"]</span></h3>
                                <span class="text-muted" style="font-size: var(--text-xs);">@AccountDisplayHelper.LocalizedAccountType(L, account.Type) · @account.Currency</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </details>
    }
}

@section Scripts {
    <script>
        (function () {
            const offcanvasEl = document.getElementById('accountOffcanvas');
            const content = document.getElementById('accountOffcanvasContent');

            async function loadIntoOffcanvas(url) {
                content.innerHTML = '<div class="text-center text-muted p-4"><span class="spinner-border spinner-border-sm me-2"></span>' + @Html.Raw(jsLoading) + '</div>';
                const bsOff = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                bsOff.show();
                const res = await fetch(url, { credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) { if (typeof showToast === 'function') showToast(@Html.Raw(jsFailedLoad)); return; }
                content.innerHTML = await res.text();
            }

            const openCreateAccount = () => loadIntoOffcanvas('@Url.Action("Create", "Account")?partial=true');
            document.getElementById('btnAddAccount')?.addEventListener('click', openCreateAccount);
            document.getElementById('btnAddAccountEmpty')?.addEventListener('click', openCreateAccount);

            document.getElementById('accountCardsRow')?.addEventListener('click', async function (e) {
                const editBtn = e.target.closest('.btn-edit');
                if (editBtn) {
                    e.preventDefault();
                    const href = editBtn.getAttribute('href');
                    if (!href) return;
                    await loadIntoOffcanvas(href + (href.includes('?') ? '&' : '?') + 'partial=true');
                }
            });

            offcanvasEl?.addEventListener('submit', async function (e) {
                const form = e.target.closest('form');
                if (!form || !offcanvasEl.contains(form)) return;
                e.preventDefault();
                const data = new FormData(form);
                const res = await fetch(form.action, { method: 'POST', body: data, credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const json = await res.json().catch(() => null);
                if (json?.success) {
                    bootstrap.Offcanvas.getInstance(offcanvasEl)?.hide();
                    location.reload();
                } else {
                    const html = await res.text().catch(() => null);
                    if (html) content.innerHTML = html;
                }
            });
        })();
    </script>
}
