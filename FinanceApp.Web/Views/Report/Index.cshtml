@using System.Text.Json
@using FinanceApp.Application.Common
@{
    ViewData["Title"] = L["Rpt_PageTitle"].Value;
    ViewData["PageDescription"] = L["Rpt_Subtitle"].Value;
    var report = ViewBag.Report as MonthlyReportResult;
    var selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
    var selectedMonth = ViewBag.SelectedMonth as int? ?? DateTime.Now.Month;
    var years = ViewBag.Years as List<int> ?? new List<int> { DateTime.Now.Year };
    var ci = CultureInfo.CurrentUICulture;
    var jsCopy = JsonSerializer.Serialize(L["Rpt_Copy"].Value);
    var jsCopied = JsonSerializer.Serialize(L["Rpt_Copied"].Value);
}

@section PageActions {
    @if (report != null)
    {
        <a asp-action="Download" asp-route-year="@report.Year" asp-route-month="@report.Month" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">
            <i class="bi bi-download" aria-hidden="true"></i> @L["Rpt_DownloadHtml"]
        </a>
        <form method="post" asp-action="CreateShareLink" asp-route-year="@report.Year" asp-route-month="@report.Month" asp-route-expiryDays="7" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-link-45deg" aria-hidden="true"></i> @L["Rpt_GetShareLink"]
            </button>
        </form>
    }
}

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="d-flex flex-nowrap align-items-center gap-2 report-form-row">
            <label class="form-label mb-0 text-nowrap">@L["Rpt_Month"]</label>
            <select name="month" class="form-select form-select-sm report-month-select">
                @for (var i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == selectedMonth)">@ci.DateTimeFormat.GetMonthName(i)</option>
                }
            </select>
            <label class="form-label mb-0 text-nowrap">@L["Rpt_Year"]</label>
            <select name="year" class="form-select form-select-sm report-year-select">
                @foreach (var y in years)
                {
                    <option value="@y" selected="@(y == selectedYear)">@y</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm">@L["Rpt_ShowReport"]</button>
        </form>
    </div>
</div>

@if (TempData["ShareReportUrl"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle mt-1" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <strong>@L["Rpt_ShareCreatedStrong"]</strong> @L["Rpt_ShareCreatedDetail", TempData["ShareReportExpires"] ?? ""]
            <div class="input-group mt-2" style="max-width: 480px;">
                <input type="text" class="form-control form-control-sm" id="shareReportUrl" value="@TempData["ShareReportUrl"]" readonly />
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('shareReportUrl').value); var b=this; b.textContent=@Html.Raw(jsCopied); setTimeout(function(){ b.textContent=@Html.Raw(jsCopy); }, 2000);">@L["Rpt_Copy"]</button>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common_Close"]"></button>
    </div>
}

@if (report != null)
{
    var monthDisplay = new DateTime(report.Year, report.Month, 1).ToString("MMMM yyyy", ci);
    <h2 class="mb-3" style="font-size: var(--text-md);">@monthDisplay</h2>

    <div class="stat-band mb-4">
        <div class="stat">
            <span class="stat__label">@L["Rpt_TotalSpent"]</span>
            <span class="stat__value">@report.TotalSpent.ToString("N0")<span class="stat__unit">@report.Currency</span></span>
        </div>
        <div class="stat">
            <span class="stat__label">@L["Rpt_TotalIncome"]</span>
            <span class="stat__value amount--positive">@report.TotalIncome.ToString("N0")<span class="stat__unit">@report.Currency</span></span>
        </div>
        <div class="stat">
            <span class="stat__label">@L["Rpt_NetCashFlow"]</span>
            <span class="stat__value @(report.NetCashFlow >= 0 ? "amount--positive" : "amount--negative")">@report.NetCashFlow.ToString("N0")<span class="stat__unit">@report.Currency</span></span>
        </div>
        @if (report.GlobalBudgetAmount.HasValue)
        {
            <div class="stat">
                <span class="stat__label">@L["Rpt_MonthlyBudget"]</span>
                <span class="stat__value @(report.IsOverGlobalBudget ? "amount--negative" : "")">@report.GlobalBudgetAmount.Value.ToString("N0")<span class="stat__unit">@report.Currency</span></span>
                @if (report.GlobalBudgetRemaining.HasValue)
                {
                    <span class="stat__meta">
                        @(report.IsOverGlobalBudget
                            ? L["Rpt_BudgetExceededBy", (-report.GlobalBudgetRemaining.Value).ToString("N0"), report.Currency]
                            : L["Rpt_BudgetLeftShort", report.GlobalBudgetRemaining.Value.ToString("N0"), report.Currency])
                    </span>
                }
            </div>
        }
    </div>

    <div class="row g-3">
        @if (report.CategoryLines.Any())
        {
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="card-title mb-3">@L["Rpt_ByCategory"]</h3>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Table_Category"]</th>
                                        <th scope="col" class="col-numeric">@L["Rpt_ColSpent"]</th>
                                        <th scope="col" class="col-numeric">@L["Rpt_ColBudget"]</th>
                                        <th scope="col" class="col-numeric">@L["Rpt_ColLeft"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in report.CategoryLines)
                                    {
                                        <tr class="@(line.IsOverBudget ? "report-row-over-budget" : "")">
                                            <td>@line.CategoryName</td>
                                            <td class="col-numeric"><span class="amount">@line.Spent.ToString("N0")<span class="amount__code">@report.Currency</span></span></td>
                                            <td class="col-numeric text-muted">@(line.BudgetAmount.HasValue ? line.BudgetAmount.Value.ToString("N0") + " " + report.Currency : L["Rpt_Dash"].Value)</td>
                                            <td class="col-numeric @(line.IsOverBudget ? "amount--negative" : "")">@(line.Remaining.HasValue ? (line.IsOverBudget ? L["Rpt_Over"].Value : line.Remaining.Value.ToString("N0")) : L["Rpt_Dash"].Value)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (report.TopExpenses.Any())
        {
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="card-title mb-3">@L["Rpt_TopExpenses"]</h3>
                        <ul class="list-unstyled mb-0">
                            @foreach (var e in report.TopExpenses.Take(10))
                            {
                                <li class="d-flex justify-content-between align-items-baseline gap-2 py-2" style="border-bottom: 1px solid var(--border);">
                                    <span class="text-truncate">
                                        @(string.IsNullOrEmpty(e.Description) ? L["Rpt_ExpenseFallback"].Value : e.Description)
                                        <span class="text-muted d-block" style="font-size: var(--text-xs);">@e.CategoryName · @e.Date.ToString("MMM d", ci)</span>
                                    </span>
                                    <span class="amount" style="white-space: nowrap;">@e.Amount.ToString("N0")<span class="amount__code">@e.Currency</span></span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @if (!report.CategoryLines.Any() && !report.TopExpenses.Any())
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="empty-state">
                            <span class="empty-state__icon"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i></span>
                            <h2 class="empty-state__title">@L["Rpt_EmptyMonth"]</h2>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
