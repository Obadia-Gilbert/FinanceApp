@using System.Text.Json
@{
    ViewData["Title"] = L["Nav_Dashboard"].Value;
    var userFirstName = ViewBag.UserFirstName as string ?? L["Generic_User"].Value;
    ViewData["PageDescription"] = L["Dash_WelcomeBack", userFirstName].Value;

    var displayCurrency = ViewBag.DisplayCurrency as string ?? "TZS";
    var expenseCount = ViewBag.ExpenseCount ?? 0;
    var totalSpend = ViewBag.TotalSpend is decimal t ? t : 0m;
    var thisMonthSpend = ViewBag.ThisMonthSpend is decimal m ? m : 0m;
    var chartLabels = ViewBag.ChartLabels ?? "[]";
    var chartData = ViewBag.ChartData ?? "[]";
    var chartCurrency = ViewBag.ChartCurrency as string ?? displayCurrency;

    var budgetAmount = ViewBag.BudgetAmount as decimal?;
    var budgetCurrency = ViewBag.BudgetCurrency as string ?? displayCurrency;
    var budgetPct = ViewBag.BudgetPct is decimal bp ? bp : 0m;
    var thisMonthSpendInBudgetCurrency = ViewBag.ThisMonthSpendInBudgetCurrency is decimal b ? b : 0m;
    var isOverBudget = ViewBag.IsOverBudget as bool? == true;
    var categoryBudgetAlerts = ViewBag.CategoryBudgetAlerts as IEnumerable<FinanceApp.Web.Models.CategoryBudgetAlertViewModel> ?? Enumerable.Empty<FinanceApp.Web.Models.CategoryBudgetAlertViewModel>();

    var totalBalance = ViewBag.TotalBalance is decimal tb ? tb : 0m;
    var monthlyIncome = ViewBag.MonthlyIncome is decimal mi ? mi : 0m;
    var momIncomeChange = ViewBag.MoMIncomeChange as decimal?;
    var momSpendChange = ViewBag.MoMSpendChange as decimal?;
    var cashFlowSixMonthLabels = ViewBag.CashFlowSixMonthLabels ?? "[]";
    var cashFlowSixMonthData = ViewBag.CashFlowSixMonthData ?? "[]";
    var recentActivity = ViewBag.RecentActivity as IEnumerable<FinanceApp.Web.Models.RecentActivityViewModel> ?? Enumerable.Empty<FinanceApp.Web.Models.RecentActivityViewModel>();
    var cashFlowThisMonth = ViewBag.CashFlowThisMonth is decimal cf ? cf : (monthlyIncome - thisMonthSpend);
    var cashFlowMoMChange = ViewBag.CashFlowMoMChange as decimal?;
    var categoryBreakdown = ViewBag.CategoryBreakdown as IEnumerable<KeyValuePair<string, decimal>> ?? Enumerable.Empty<KeyValuePair<string, decimal>>();
    var categoryMax = categoryBreakdown.Any() ? categoryBreakdown.Max(x => x.Value) : 0m;

    var hasBudget = budgetAmount.HasValue && budgetAmount.Value > 0;
    var hasCashFlowHistory = cashFlowSixMonthData?.ToString() != "[]" && expenseCount > 0;

    var jsChartCashFlow = JsonSerializer.Serialize(L["Chart_CashFlow"].Value);
    var jsChartDailyExpenses = JsonSerializer.Serialize(L["Chart_DailyExpenses"].Value);
    var jsChartAmountAxis = JsonSerializer.Serialize(L["Chart_AmountAxis", chartCurrency].Value);

    // One consolidated "needs attention" list rather than a stack of banners.
    var attentionItems = new List<(string Text, bool IsSevere)>();
    if (isOverBudget)
    {
        attentionItems.Add((L["Dash_BudgetSpentBody", thisMonthSpendInBudgetCurrency.ToString("N0"), budgetCurrency, budgetAmount?.ToString("N0") ?? "0", budgetCurrency].Value, true));
    }
    foreach (var alert in categoryBudgetAlerts)
    {
        var catName = alert.CategoryName ?? L["Generic_Category"].Value;
        var label = alert.IsOver ? L["Dash_BudgetExceededLabel"].Value : L["Dash_BudgetNearLabel"].Value;
        attentionItems.Add(($"{catName} {label} {alert.Spent:N0} / {alert.Budget:N0} {alert.Currency ?? displayCurrency}", alert.IsOver));
    }
}

@section PageActions {
    <span class="filter-chip" aria-label="@L["Dash_ThisMonth"]">
        <i class="bi bi-calendar3" aria-hidden="true"></i> @L["Dash_ThisMonth"]
    </span>
    <a asp-controller="Expense" asp-action="Index" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Dash_AddExpense"]
    </a>
}

@* ── First run: one clear next step, not a wall of banners ─────────── *@
@if (expenseCount == 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state__icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <h2 class="empty-state__title">@L["Dash_NoExpensesStrong"]</h2>
                <p class="empty-state__desc">@L["Dash_EmptyDashboardHelp"]</p>
                <a asp-controller="Expense" asp-action="Index" class="btn btn-primary empty-state__action">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Dash_AddExpense"]
                </a>
            </div>
        </div>
    </div>
}
else
{
    @* ── Needs attention ───────────────────────────────────────────── *@
    @if (attentionItems.Any())
    {
        var anySevere = attentionItems.Any(a => a.IsSevere);
        <div class="alert @(anySevere ? "alert-danger" : "alert-warning") mb-4" role="alert">
            <i class="bi @(anySevere ? "bi-exclamation-triangle-fill" : "bi-exclamation-circle") mt-1" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <strong>@L["Dash_NeedsAttention"]</strong>
                <ul class="mb-0 mt-1 ps-3">
                    @foreach (var item in attentionItems)
                    {
                        <li>@item.Text</li>
                    }
                </ul>
                <a asp-controller="Budget" asp-action="Index" class="alert-link d-inline-block mt-2">@L["Dash_ManageBudgets"]</a>
            </div>
        </div>
    }

    @* ── The four figures that matter, read as one set ─────────────── *@
    <div class="stat-band mb-4">
        <div class="stat">
            <span class="stat__label">@L["KPI_TotalBalance"]</span>
            <span class="stat__value">@totalBalance.ToString("N2")<span class="stat__unit">@displayCurrency</span></span>
        </div>
        <div class="stat">
            <span class="stat__label">@L["KPI_MonthlyIncome"]</span>
            <span class="stat__value">@monthlyIncome.ToString("N2")<span class="stat__unit">@displayCurrency</span></span>
            @if (momIncomeChange.HasValue)
            {
                <span class="stat__meta">
                    <span class="delta @(momIncomeChange >= 0 ? "delta--up" : "delta--down")">
                        <i class="bi @(momIncomeChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")" aria-hidden="true"></i>@Math.Abs(momIncomeChange.Value).ToString("F1")%
                    </span>
                    @L["Dash_VsLastMonth"]
                </span>
            }
        </div>
        <div class="stat">
            <span class="stat__label">@L["KPI_MonthlyExpense"]</span>
            <span class="stat__value">@thisMonthSpend.ToString("N2")<span class="stat__unit">@displayCurrency</span></span>
            @if (momSpendChange.HasValue)
            {
                <span class="stat__meta">
                    @* For spending, an increase is the unwelcome direction. *@
                    <span class="delta @(momSpendChange <= 0 ? "delta--up" : "delta--down")">
                        <i class="bi @(momSpendChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")" aria-hidden="true"></i>@Math.Abs(momSpendChange.Value).ToString("F1")%
                    </span>
                    @L["Dash_VsLastMonth"]
                </span>
            }
        </div>
        <div class="stat">
            <span class="stat__label">@L["Dash_NetCashFlow"]</span>
            <span class="stat__value @(cashFlowThisMonth < 0 ? "text-danger" : "")">@cashFlowThisMonth.ToString("N2")<span class="stat__unit">@displayCurrency</span></span>
            <span class="stat__meta">@L["Dash_IncomeMinusExpenses"]</span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @* ── Cash flow ─────────────────────────────────────────────── *@
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-header">
                        <h2 class="card-title">@L["Dash_MonthlyCashFlow"]</h2>
                        <a asp-controller="Budget" asp-action="Index" class="btn btn-link btn-sm p-0">@L["Dash_ViewBudget"]</a>
                    </div>
                    @if (hasCashFlowHistory)
                    {
                        <div class="dashboard-bar-chart-wrap" style="height: 180px;">
                            <canvas id="cashFlowChart" height="180" aria-label="@L["Dash_MonthlyCashFlow"]" role="img"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="panel-empty">
                            <i class="bi bi-bar-chart" aria-hidden="true"></i>
                            <span>@L["Dash_NoCashFlowData"]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Budget progress ───────────────────────────────────────── *@
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-header">
                        <h2 class="card-title">@L["Dash_BudgetProgress"]</h2>
                        <a asp-controller="Budget" asp-action="Index" class="btn btn-link btn-sm p-0">@L["Dash_ManageBudgets"]</a>
                    </div>
                    @if (hasBudget)
                    {
                        @* ViewBag.BudgetPct is clamped to 100 for the bar; the label needs
                           the real figure, otherwise being 64% over budget reads as "100%". *@
                        var truePct = (double)(thisMonthSpendInBudgetCurrency / budgetAmount!.Value * 100m);
                        var pctUsed = Math.Min(100, truePct);
                        <p class="figure-display mb-1" style="font-size: var(--text-xl);">
                            @thisMonthSpendInBudgetCurrency.ToString("N0")<span class="stat__unit">@budgetCurrency</span>
                        </p>
                        <p class="text-muted mb-3" style="font-size: var(--text-sm);">
                            @L["Dash_OfBudgetUsed", budgetAmount!.Value.ToString("N0") + " " + budgetCurrency, truePct.ToString("0.#")]
                        </p>
                        <div class="meter" role="progressbar" aria-valuenow="@Math.Round(truePct)" aria-valuemin="0" aria-valuemax="100" aria-label="@L["Dash_BudgetProgress"]">
                            <div class="meter__fill @(isOverBudget ? "meter__fill--over" : truePct >= 80 ? "meter__fill--warning" : "")" style="width: @pctUsed.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="panel-empty">
                            <i class="bi bi-pie-chart" aria-hidden="true"></i>
                            <span>@L["Dash_NoBudgetSet"]</span>
                            <a asp-controller="Budget" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">@L["Dash_SetBudgetLink"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @* ── Top categories (was computed, then discarded) ──────────── *@
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-header">
                        <h2 class="card-title">@L["Dash_TopCategories"]</h2>
                        <a asp-controller="Report" asp-action="Index" class="btn btn-link btn-sm p-0">@L["Dash_ViewAll"]</a>
                    </div>
                    @if (categoryBreakdown.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var cat in categoryBreakdown)
                            {
                                var share = categoryMax > 0 ? (double)(cat.Value / categoryMax * 100) : 0;
                                <li class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline gap-2 mb-1">
                                        <span class="text-truncate" style="color: var(--ink-900);">@cat.Key</span>
                                        <span class="amount" style="font-size: var(--text-sm);">@cat.Value.ToString("N0")</span>
                                    </div>
                                    <div class="meter" style="height: 4px;">
                                        <div class="meter__fill" style="width: @share.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="panel-empty">
                            <i class="bi bi-tags" aria-hidden="true"></i>
                            <span>@L["Dash_NoCategorySpend"]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Recent activity ───────────────────────────────────────── *@
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <div class="section-header">
                        <h2 class="card-title">@L["Dash_RecentTransactions"]</h2>
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-link btn-sm p-0">@L["Dash_ViewAll"]</a>
                    </div>
                    @if (recentActivity.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Table_Date"]</th>
                                        <th scope="col">@L["Table_Category"]</th>
                                        <th scope="col" class="col-numeric">@L["Table_Amount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in recentActivity.Take(6))
                                    {
                                        <tr>
                                            <td class="text-muted" style="white-space: nowrap; font-size: var(--text-sm);">@a.Date.ToString("MMM d")</td>
                                            <td>
                                                <span class="d-inline-flex align-items-center gap-2">
                                                    <span class="status-dot @(a.IsIncome ? "status-dot--positive" : "status-dot--negative")" aria-hidden="true"></span>
                                                    <span class="text-truncate">@a.CategoryName</span>
                                                </span>
                                            </td>
                                            <td class="col-numeric">
                                                <span class="amount @(a.IsIncome ? "amount--positive" : "")">
                                                    @(a.IsIncome ? "+" : "−")@Math.Abs(a.Amount).ToString("N2")<span class="amount__code">@a.Currency</span>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="panel-empty">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <span>@L["Dash_NoRecentTx"]</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── 30-day trend ──────────────────────────────────────────────── *@
    <div class="card">
        <div class="card-body">
            <div class="section-header">
                <h2 class="card-title">@L["Dash_ExpenseTrendTitle", chartCurrency]</h2>
                <span class="text-muted" style="font-size: var(--text-xs);">@L["Dash_AllTimeSpend"]: <span class="amount">@totalSpend.ToString("N0")</span> @displayCurrency</span>
            </div>
            <div class="expense-chart-wrap">
                <canvas id="expenseChart" height="80" aria-label="@L["Dash_ExpenseTrendTitle", chartCurrency]" role="img"></canvas>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function() {
            // Chart colours are read from the live design tokens so the charts
            // stay in step with the theme instead of hard-coding a second palette.
            function token(name, fallback) {
                var v = getComputedStyle(document.documentElement).getPropertyValue(name);
                return (v && v.trim()) || fallback;
            }
            function chartColors() {
                return {
                    accent: token('--brand', '#0D9488'),
                    grid:   token('--border', '#DEE7E7'),
                    text:   token('--ink-500', '#5F757E'),
                    muted:  token('--ink-400', '#8CA0A8')
                };
            }
            function withAlpha(hex, alpha) {
                var h = hex.replace('#', '');
                if (h.length === 3) { h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2]; }
                var n = parseInt(h, 16);
                return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + alpha + ')';
            }

            var charts = [];

            var cashFlowCanvas = document.getElementById('cashFlowChart');
            if (cashFlowCanvas) {
                var cfLabels = @Html.Raw(cashFlowSixMonthLabels);
                var cfData = @Html.Raw(cashFlowSixMonthData);
                var c = chartColors();
                var cashFlow = new Chart(cashFlowCanvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: cfLabels,
                        datasets: [{
                            label: @Html.Raw(jsChartCashFlow),
                            data: cfData,
                            backgroundColor: cfData.map(function(_, i) {
                                return i === cfData.length - 1 ? c.accent : withAlpha(c.accent, 0.35);
                            }),
                            borderRadius: 4,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { ticks: { color: c.text }, grid: { display: false }, border: { display: false } },
                            y: { beginAtZero: true, ticks: { color: c.muted }, grid: { color: c.grid }, border: { display: false } }
                        }
                    }
                });
                charts.push({ chart: cashFlow, kind: 'bar' });
            }

            var canvas = document.getElementById('expenseChart');
            if (canvas) {
                var c2 = chartColors();
                var trend = new Chart(canvas.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(chartLabels),
                        datasets: [{
                            label: @Html.Raw(jsChartDailyExpenses),
                            data: @Html.Raw(chartData),
                            borderColor: c2.accent,
                            backgroundColor: withAlpha(c2.accent, 0.10),
                            borderWidth: 2,
                            tension: 0.35,
                            fill: true,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointBackgroundColor: c2.accent
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: { legend: { display: false } },
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: { ticks: { color: c2.muted, maxTicksLimit: 8 }, grid: { display: false }, border: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { color: c2.muted },
                                grid: { color: c2.grid },
                                border: { display: false },
                                title: { display: true, text: @Html.Raw(jsChartAmountAxis), color: c2.muted }
                            }
                        }
                    }
                });
                charts.push({ chart: trend, kind: 'line' });
            }

            // Recolour on theme change instead of leaving stale colours behind.
            document.addEventListener('themechange', function() {
                var c = chartColors();
                charts.forEach(function(entry) {
                    var ch = entry.chart;
                    var ds = ch.data.datasets[0];
                    if (entry.kind === 'line') {
                        ds.borderColor = c.accent;
                        ds.backgroundColor = withAlpha(c.accent, 0.10);
                        ds.pointBackgroundColor = c.accent;
                        ch.options.scales.y.title.color = c.muted;
                    } else {
                        ds.backgroundColor = ds.data.map(function(_, i) {
                            return i === ds.data.length - 1 ? c.accent : withAlpha(c.accent, 0.35);
                        });
                    }
                    ch.options.scales.x.ticks.color = entry.kind === 'bar' ? c.text : c.muted;
                    ch.options.scales.y.ticks.color = c.muted;
                    ch.options.scales.y.grid.color = c.grid;
                    ch.update();
                });
            });
        })();
    </script>
}
