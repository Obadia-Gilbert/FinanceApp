@model FinanceApp.Application.Common.PagedResult<FinanceApp.Domain.Entities.Expense>
@using System.Text.Json
@{
    ViewData["Title"] = L["Exp_PageTitle"].Value;
    ViewData["PageDescription"] = L["Exp_Subtitle"].Value;

    var jsExpErrLoad = JsonSerializer.Serialize(L["Exp_ErrLoadForm"].Value);
    var jsExpErrEdit = JsonSerializer.Serialize(L["Exp_ErrLoadEdit"].Value);
    var jsExpErrDelete = JsonSerializer.Serialize(L["Exp_ErrLoadDelete"].Value);
    var jsExpErrReceipt = JsonSerializer.Serialize(L["Exp_ErrLoadReceipt"].Value);
    var jsDtInfo = JsonSerializer.Serialize(L["Exp_DTInfo"].Value);
    var jsDtFiltered = JsonSerializer.Serialize(L["Exp_DTInfoFiltered"].Value);
    var jsDtLength = JsonSerializer.Serialize(L["Exp_DTLengthMenu"].Value);
    var jsCommonLoading = JsonSerializer.Serialize(L["Common_Loading"].Value);

    var categories = Model.Items
        .Where(e => e.Category != null && !string.IsNullOrEmpty(e.Category.Name))
        .Select(e => e.Category!.Name!)
        .Distinct()
        .OrderBy(n => n)
        .ToList();
}

@section PageActions {
    <button id="btnAddExpense" class="btn btn-primary" type="button">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Exp_AddNew"]
    </button>
    <a class="btn btn-outline-secondary" asp-action="DownloadExcel">
        <i class="bi bi-download" aria-hidden="true"></i> @L["Exp_DownloadExcel"]
    </a>
}

<div class="card">
    @if (Model.Items.Any())
    {
        @* Toolbar: search and filters sit above the table, as one row of
           controls, rather than DataTables' default scattered chrome. *@
        <div class="data-toolbar">
            <div class="search-field">
                <i class="bi bi-search search-field__icon" aria-hidden="true"></i>
                <label for="expenseSearch" class="visually-hidden">@L["Exp_DTSearchPlaceholder"]</label>
                <input type="search" id="expenseSearch" class="form-control form-control-sm" placeholder="@L["Exp_DTSearchPlaceholder"]" />
            </div>
            @if (categories.Count > 1)
            {
                <span class="filter-chip" id="categoryFilterChip">
                    <i class="bi bi-tag" aria-hidden="true"></i>
                    <label for="categoryFilter" class="visually-hidden">@L["Lbl_Category"]</label>
                    <select id="categoryFilter">
                        <option value="">@L["Exp_AllCategories"]</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </span>
            }
            <div class="data-toolbar__spacer"></div>
            <span class="text-muted" id="expenseCount" style="font-size: var(--text-xs);"></span>
        </div>

        <div class="table-responsive">
            <table id="expenseTable" class="table table-hover mb-0" aria-label="@L["Exp_TableAria"]">
                <caption class="visually-hidden">@L["Exp_TableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@L["Lbl_Description"]</th>
                        <th scope="col">@L["Lbl_Category"]</th>
                        <th scope="col">@L["Table_Date"]</th>
                        <th scope="col" class="col-numeric">@L["Table_Amount"]</th>
                        <th scope="col" class="text-center"><span class="visually-hidden">@L["Exp_ColAttachments"]</span><i class="bi bi-paperclip" aria-hidden="true" title="@L["Exp_ColAttachments"]"></i></th>
                        <th scope="col" class="col-actions"><span class="visually-hidden">@L["Table_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.Items)
                    {
                        <tr>
                            <td style="color: var(--ink-900);">@expense.Description</td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-2">
                                    <span class="status-dot" aria-hidden="true"></span>
                                    <span>@expense.Category?.Name</span>
                                </span>
                            </td>
                            @* data-order keeps sorting chronological / numeric even though
                               the cell displays a formatted, human-readable value. *@
                            <td data-order="@expense.ExpenseDate.ToString("yyyyMMdd")" class="text-muted" style="white-space: nowrap;">
                                @expense.ExpenseDate.ToString("d MMM yyyy")
                            </td>
                            <td class="col-numeric" data-order="@expense.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <span class="amount">@expense.Amount.ToString("N2")<span class="amount__code">@expense.Currency</span></span>
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(expense.ReceiptPath))
                                {
                                    <button type="button" class="icon-btn btn-receipt-preview" data-expense-id="@expense.Id" title="@L["Exp_ReceiptPreviewTitle"]" aria-label="@L["Exp_ReceiptPreviewTitle"]">
                                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                                    </button>
                                }
                            </td>
                            <td class="col-actions">
                                <span class="row-actions">
                                    <a class="icon-btn btn-edit" href="@Url.Action("Edit", "Expense", new { id = expense.Id })" title="@L["Common_Edit"]" aria-label="@L["Exp_EditAria"]">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <a class="icon-btn icon-btn--danger btn-delete" href="@Url.Action("Delete", "Expense", new { id = expense.Id })" title="@L["Common_Delete"]" aria-label="@L["Exp_DeleteAria"]">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </a>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state__icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <h2 class="empty-state__title">@L["Exp_EmptyTitle"]</h2>
                <p class="empty-state__desc">@L["Exp_EmptyDesc"]</p>
                <button id="btnAddExpenseEmpty" class="btn btn-primary empty-state__action" type="button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Exp_AddNew"]
                </button>
            </div>
        </div>
    }
</div>

<!-- Offcanvas container for create/edit forms -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="expenseOffcanvas" aria-labelledby="expenseOffcanvasLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="expenseOffcanvasLabel">@L["Exp_OffcanvasTitle"]</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["Common_Close"]"></button>
    </div>
    <div class="offcanvas-body">
        <div class="p-3 d-flex align-items-center justify-content-center min-vh-25" id="expenseOffcanvasContent">
            <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@L["Common_Loading"]</div>
        </div>
    </div>
</div>

<!-- Receipt preview modal -->
<div class="modal fade" id="receiptPreviewModal" tabindex="-1" aria-labelledby="receiptPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="receiptPreviewModalLabel">@L["Exp_ReceiptModalTitle"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common_Close"]"></button>
            </div>
            <div class="modal-body p-0 text-center" style="background-color: var(--surface-inset);">
                <div id="receiptPreviewContent" style="min-height: 400px;">
                    <div class="d-flex align-items-center justify-content-center py-5">
                        <div class="spinner-border" role="status"><span class="visually-hidden">@L["Common_Loading"]</span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="receiptPreviewDownload" href="#" target="_blank" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>@L["Exp_OpenNewTab"]
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@L["Common_Close"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            var $table = $('#expenseTable');
            if (!$table.length) return;

            var table = $table.DataTable({
                paging: true,
                searching: true,
                ordering: true,
                pageLength: 15,
                order: [[2, 'desc']],   // newest first — the useful default for a ledger
                // Receipt and action columns hold controls, not data: nothing to sort by.
                columnDefs: [{ orderable: false, targets: [4, 5] }],
                @* Count lives in the toolbar, so the footer carries pagination only. *@
                dom: 't<"dt-footer"p>',
                language: {
                    info: @Html.Raw(jsDtInfo),
                    infoFiltered: @Html.Raw(jsDtFiltered),
                    lengthMenu: @Html.Raw(jsDtLength),
                    paginate: { first: "«", last: "»", next: "›", previous: "‹" }
                }
            });

            // Toolbar search drives the table rather than DataTables' own input.
            $('#expenseSearch').on('input', function () {
                table.search(this.value).draw();
            });

            $('#categoryFilter').on('change', function () {
                var val = this.value;
                // Escape so a category containing regex characters still matches.
                table.column(1).search(val ? '^' + val.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$' : '', true, false).draw();
                $('#categoryFilterChip').toggleClass('filter-chip--active', !!val);
            });

            function updateCount() {
                var info = table.page.info();
                $('#expenseCount').text(info.recordsDisplay === info.recordsTotal
                    ? info.recordsTotal + ' ' + '@L["Exp_RecordsLabel"]'
                    : info.recordsDisplay + ' / ' + info.recordsTotal + ' ' + '@L["Exp_RecordsLabel"]');
                // A pager for a single page is noise.
                $('.dt-footer').toggle(info.pages > 1);
            }
            table.on('draw', updateCount);
            updateCount();
        });
    </script>
    <script>
        (function(){
            const loadingHtml = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + @Html.Raw(jsCommonLoading) + '</div>';

            async function openForm(url, fallbackMsg) {
                const content = document.getElementById('expenseOffcanvasContent');
                const offcanvasEl = document.getElementById('expenseOffcanvas');
                content.innerHTML = loadingHtml;
                if (offcanvasEl) { bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl).show(); }
                const res = await fetch(url, { credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' }});
                if (!res.ok) {
                    var msg = fallbackMsg + ' (' + res.status + ')';
                    if (typeof showToast === 'function') showToast(msg); else alert(msg);
                    content.innerHTML = '<div class="p-3 text-danger">' + msg + '</div>';
                    return;
                }
                content.innerHTML = await res.text();
            }

            const createUrl = '@Url.Action("Create","Expense")?partial=true';
            document.getElementById('btnAddExpense')?.addEventListener('click', function(e){
                e.preventDefault();
                openForm(createUrl, @Html.Raw(jsExpErrLoad));
            });
            document.getElementById('btnAddExpenseEmpty')?.addEventListener('click', function(e){
                e.preventDefault();
                openForm(createUrl, @Html.Raw(jsExpErrLoad));
            });

            const tableEl = document.querySelector('#expenseTable');
            tableEl?.addEventListener('click', function(e){
                const editBtn = e.target.closest('.btn-edit');
                if (editBtn) {
                    e.preventDefault();
                    const href = editBtn.getAttribute('href');
                    if (href) openForm(href + (href.indexOf('?') === -1 ? '?partial=true' : '&partial=true'), @Html.Raw(jsExpErrEdit));
                    return;
                }
                const delBtn = e.target.closest('.btn-delete');
                if (delBtn) {
                    e.preventDefault();
                    const href = delBtn.getAttribute('href');
                    if (href) openForm(href + (href.indexOf('?') === -1 ? '?partial=true' : '&partial=true'), @Html.Raw(jsExpErrDelete));
                    return;
                }
            });

            // Receipt preview modal
            var receiptModal = document.getElementById('receiptPreviewModal');
            var receiptContent = document.getElementById('receiptPreviewContent');
            var receiptDownload = document.getElementById('receiptPreviewDownload');
            function openReceiptPreview(expenseId) {
                if (!receiptModal || !receiptContent) return;
                var url = '@Url.Action("Receipt", "Expense")/' + expenseId;
                receiptContent.innerHTML = '<div class="d-flex align-items-center justify-content-center py-5"><div class="spinner-border" role="status"></div></div>';
                receiptDownload.href = url;
                bootstrap.Modal.getOrCreateInstance(receiptModal).show();
                var xhr = new XMLHttpRequest();
                xhr.open('GET', url);
                xhr.responseType = 'blob';
                xhr.onload = function() {
                    if (xhr.status !== 200) {
                        receiptContent.innerHTML = '<p class="py-5 text-muted">' + @Html.Raw(jsExpErrReceipt) + '</p>';
                        return;
                    }
                    var contentType = xhr.getResponseHeader('Content-Type') || '';
                    if (contentType.indexOf('pdf') !== -1) {
                        receiptContent.innerHTML = '<iframe src="' + url + '" style="width:100%;height:500px;border:none;" title="@L["Exp_ReceiptPdfTitle"]"></iframe>';
                    } else {
                        var reader = new FileReader();
                        reader.onload = function() {
                            receiptContent.innerHTML = '<img src="' + reader.result + '" alt="@L["Exp_ReceiptModalTitle"]" style="max-width:100%;max-height:70vh;object-fit:contain;" />';
                        };
                        reader.readAsDataURL(xhr.response);
                    }
                };
                xhr.onerror = function() {
                    receiptContent.innerHTML = '<p class="py-5 text-muted">' + @Html.Raw(jsExpErrReceipt) + '</p>';
                };
                xhr.send();
            }
            tableEl?.addEventListener('click', function(e) {
                var btn = e.target.closest('.btn-receipt-preview');
                if (btn) {
                    e.preventDefault();
                    var id = btn.getAttribute('data-expense-id');
                    if (id) openReceiptPreview(id);
                }
            });
            document.querySelector('#expenseOffcanvasContent')?.addEventListener('click', function(e) {
                var btn = e.target.closest('.btn-preview-receipt');
                if (btn) {
                    e.preventDefault();
                    var id = btn.getAttribute('data-expense-id');
                    if (id) openReceiptPreview(id);
                }
            });
        })();
    </script>
}
