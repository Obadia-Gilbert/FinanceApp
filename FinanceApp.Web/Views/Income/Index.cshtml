@model IEnumerable<FinanceApp.Web.Models.IncomeListViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = L["Inc_PageTitle"].Value;
    ViewData["PageDescription"] = L["Inc_Subtitle"].Value;
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var jsIncDel = JsonSerializer.Serialize(L["Inc_DeleteConfirm"].Value);
    var jsCommonLoading = JsonSerializer.Serialize(L["Common_Loading"].Value);
}

@section PageActions {
    <button id="btnAddIncome" class="btn btn-primary" type="button">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Inc_Add"]
    </button>
}

<div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="incomeOffcanvas" aria-labelledby="incomeOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 id="incomeOffcanvasLabel">@L["Inc_OffcanvasTitle"]</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@L["Common_Close"]"></button>
        </div>
        <div class="offcanvas-body px-0">
            <div class="p-3 d-flex align-items-center justify-content-center min-vh-25" id="incomeOffcanvasContent">
                <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@L["Common_Loading"]</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state__icon"><i class="bi bi-arrow-down-left-circle" aria-hidden="true"></i></span>
                <h2 class="empty-state__title">@L["Inc_EmptyPart1"]</h2>
                <p class="empty-state__desc">@L["Inc_EmptyPart2"]</p>
                <button id="btnAddIncomeEmpty" class="btn btn-primary empty-state__action" type="button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Inc_Add"]
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="incomeTable" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@L["Table_Date"]</th>
                            <th scope="col">@L["Tx_ColAccount"]</th>
                            <th scope="col">@L["Lbl_Category"]</th>
                            <th scope="col">@L["Inc_ColDescSource"]</th>
                            <th scope="col" class="col-numeric">@L["Table_Amount"]</th>
                            <th scope="col" class="col-actions"><span class="visually-hidden">@L["Table_Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-nowrap text-muted" style="font-size: var(--text-sm);">@item.IncomeDate.ToString("d MMM yyyy")</td>
                                <td>@(string.IsNullOrEmpty(item.AccountName) ? "—" : item.AccountName)</td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="status-dot status-dot--positive" aria-hidden="true"></span>
                                        <span>@item.CategoryName</span>
                                    </span>
                                </td>
                                <td class="text-truncate" style="max-width:200px;" title="@(item.Description ?? item.Source ?? "—")">@(item.Description ?? item.Source ?? "—")</td>
                                <td class="col-numeric">
                                    <span class="amount amount--positive">+@item.Amount.ToString("N2")<span class="amount__code">@item.Currency</span></span>
                                </td>
                                <td class="col-actions">
                                    <span class="row-actions">
                                        <a href="@Url.Action("Edit", "Income", new { id = item.Id })" class="icon-btn btn-edit" title="@L["Common_Edit"]" aria-label="@L["Common_Edit"]">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-controller="Income" asp-route-id="@item.Id" style="display:inline" onsubmit="return confirm(@Html.Raw(jsIncDel));">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="icon-btn icon-btn--danger" title="@L["Common_Delete"]" aria-label="@L["Common_Delete"]">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="@L["Inc_PaginationAria"]">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)">@L["Tx_Prev"]</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == pageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@p">@p</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)">@L["Tx_Next"]</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    <script>
        (function () {
            const offcanvasEl = document.getElementById('incomeOffcanvas');
            const content = document.getElementById('incomeOffcanvasContent');

            async function loadIntoOffcanvas(url) {
                content.innerHTML = '<div class="text-center text-muted p-4"><span class="spinner-border spinner-border-sm me-2"></span>' + @Html.Raw(jsCommonLoading) + '</div>';
                bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl).show();
                const res = await fetch(url, { credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) return;
                content.innerHTML = await res.text();
            }

            const openCreate = () => loadIntoOffcanvas('@Url.Action("Create", "Income")?partial=true');
            document.getElementById('btnAddIncome')?.addEventListener('click', openCreate);
            document.getElementById('btnAddIncomeEmpty')?.addEventListener('click', openCreate);

            document.getElementById('incomeTable')?.addEventListener('click', async function (e) {
                const editBtn = e.target.closest('.btn-edit');
                if (editBtn) {
                    e.preventDefault();
                    const href = editBtn.getAttribute('href');
                    if (href) await loadIntoOffcanvas(href + (href.includes('?') ? '&' : '?') + 'partial=true');
                }
            });

            offcanvasEl?.addEventListener('submit', async function (e) {
                const form = e.target.closest('form');
                if (!form || !offcanvasEl.contains(form)) return;
                e.preventDefault();
                const data = new FormData(form);
                const res = await fetch(form.action, { method: 'POST', body: data, credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json, text/html;q=0.9' } });
                const raw = await res.text();
                if (!raw) return;
                const trimmed = raw.trimStart();
                if (trimmed.startsWith('{')) {
                    try {
                        const json = JSON.parse(raw);
                        if (json && json.success) {
                            bootstrap.Offcanvas.getInstance(offcanvasEl)?.hide();
                            location.reload();
                        }
                    } catch (_) { /* fall through */ }
                    return;
                }
                content.innerHTML = raw;
            });
        })();
    </script>
}
