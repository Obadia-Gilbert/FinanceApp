<!DOCTYPE html>
@using System.Text.Json
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    var showShell = !path.Contains("/identity/account/login") && !path.Contains("/identity/account/register") && !path.Contains("/identity/account/forgotpassword") && !path.Contains("/identity/account/externallogin") && !path.Contains("/home/privacy") && !path.Contains("/home/terms");
}
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinanceApp</title>

    @* Resolve the theme before first paint. Without this the page renders
       light and then flips, which is very visible for dark-theme users.
       `data-bs-theme` also switches Bootstrap's own inverted assets
       (close buttons, select chevrons) — site.css then overrides its palette. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { /* private mode — fall back to light */ }
        })();
    </script>

    <link rel="icon" type="image/png" href="~/financeapp-logo.png" asp-append-version="true" />
    <script type="importmap"></script>
    <!-- Antiforgery token for AJAX POSTs -->
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Instrument Sans for the interface; IBM Plex Mono for figures, so every
       column of money lines up on the decimal. *@
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinanceApp.Web.styles.css" asp-append-version="true" />
</head>
<body data-theme="light">

    <!-- ── Fixed top bar ────────────────────────────────────────── -->
    <header class="app-header">
        @* navbar-expand-lg is required, not decorative: Bootstrap's base rule is
           `.navbar-nav .dropdown-menu { position: static }` (the collapsed/mobile
           case) and only `.navbar-expand-lg .navbar-nav .dropdown-menu { position:
           absolute }` at >=992px restores real floating positioning. Without it,
           the profile dropdown renders in normal document flow instead of as a
           floating panel, shoving the whole icon row upward. *@
        <nav class="navbar navbar-expand-lg navbar-modern">
            <div class="container-fluid px-2 px-sm-3">
                @if (showShell)
                {
                    <!-- Menu toggle: mobile only, leading position -->
                    <button class="navbar-icon-btn d-md-none" type="button"
                            data-bs-toggle="collapse" data-bs-target="#sidebarCollapse"
                            aria-controls="sidebarCollapse" aria-expanded="false"
                            aria-label="@L["Aria_Menu"]" title="@L["Aria_Menu"]">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                }

                <!-- Brand: landing when signed out, dashboard when signed in -->
                <a class="navbar-brand" asp-area="" asp-controller="@(User.Identity?.IsAuthenticated == true ? "Home" : "Landing")" asp-action="Index">
                    <img src="~/financeapp-logo.png" asp-append-version="true" alt="" width="28" height="28" style="border-radius:7px; flex-shrink:0;" />
                    <span class="d-none d-sm-inline navbar-brand-text">FinanceApp</span>
                </a>

                <!-- Right-side actions -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                    @if (showShell)
                    {
                        <div class="d-none d-md-block"><partial name="_LanguageSwitcher" /></div>
                    }
                    <button id="themeToggle" class="theme-toggle navbar-icon-btn d-none d-md-inline-flex"
                            title="@L["Nav_ToggleTheme"]" aria-label="@L["Nav_ToggleTheme"]">
                        <i class="bi bi-moon" aria-hidden="true"></i>
                    </button>
                    @if (showShell)
                    {
                        <div class="d-inline-block" id="notificationDropdownWrap">
                        <div class="dropdown dropdown-notification d-none d-md-block position-relative" id="notificationDropdown">
                            <button class="navbar-icon-btn position-relative" type="button" id="notificationBell" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bs-boundary="viewport" aria-expanded="false" aria-label="@L["Nav_Notifications"]">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill" id="notificationBadge" style="display: none; font-size: 0.6rem; background-color: var(--negative); color: #fff;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end notification-dropdown" style="min-width: 320px; max-width: 360px; padding: 0;" aria-labelledby="notificationBell">
                                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                    <span class="fw-600">@L["Notif_DropdownTitle"]</span>
                                    <button type="button" class="btn btn-link btn-sm p-0" id="notificationMarkAllRead" title="@L["Notif_MarkAllTitle"]">@L["Notif_MarkAllRead"]</button>
                                </div>
                                <div class="px-3 py-3 text-center text-muted small" id="notificationListLoading">@L["Common_Loading"]</div>
                                <ul class="list-group list-group-flush list-unstyled mb-0" id="notificationList" style="max-height: 280px; overflow-y: auto;"></ul>
                                <div class="text-center py-2 border-top"><a asp-controller="Notification" asp-action="Index" class="small">@L["Notif_ViewAll"]</a></div>
                            </div>
                        </div>
                        </div>
                        <div class="d-none d-md-block">
                            @await Component.InvokeAsync("UserProfile")
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- ── App shell: sidebar + scrollable main ─────────────────── -->
    <div class="app-shell">
        @if (showShell)
        {
            <!-- Fixed sidebar (desktop) / overlay (mobile) -->
            <aside class="app-sidebar collapse d-md-block" id="sidebarCollapse">
                @await Html.PartialAsync("_Sidebar")
            </aside>

            <!-- Scrollable main content -->
            <main class="app-main" id="mainContent">
                <div class="app-main-content">
                    @* Every page gets a real, visible heading. Views supply an
                       optional one-line description and their own primary actions
                       via the "PageActions" section, so the header stays consistent
                       without each view re-inventing it. Set ViewData["HidePageHeader"]
                       to opt out (e.g. a page that owns its whole canvas). *@
                    @if (ViewData["HidePageHeader"] as bool? != true)
                    {
                        <div class="page-header">
                            <div class="page-header__text">
                                <h1 class="page-header__title">@(ViewData["PageTitle"] ?? ViewData["Title"])</h1>
                                @if (ViewData["PageDescription"] is string pageDescription && !string.IsNullOrWhiteSpace(pageDescription))
                                {
                                    <p class="page-header__desc">@pageDescription</p>
                                }
                            </div>
                            @if (IsSectionDefined("PageActions"))
                            {
                                <div class="page-header__actions">
                                    @await RenderSectionAsync("PageActions", required: false)
                                </div>
                            }
                        </div>
                    }
                    @RenderBody()
                </div>

                <footer class="app-footer mt-auto">
                    <div class="container-fluid px-3 px-md-4 py-3">
                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                            <span>&copy; @DateTime.Now.Year FinanceApp</span>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">@L["Nav_Privacy"]</a>
                                <a asp-area="" asp-controller="Feedback" asp-action="Index" class="footer-link">@L["Nav_Feedback"]</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </main>
        }
        else
        {
            <!-- Auth pages: full-width, no sidebar -->
            <main class="app-main app-main--full">
                <div class="app-main-content">
                    @RenderBody()
                </div>
            </main>
        }
    </div>

    <!-- Toast container (stays fixed regardless of scroll) -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <script>
        window.__financeAppI18n = window.__financeAppI18n || {};
        window.__financeAppI18n.notifEmpty = @Html.Raw(JsonSerializer.Serialize(L["Notif_NoneDropdown"].Value));
        window.__financeAppI18n.notifMarkRead = @Html.Raw(JsonSerializer.Serialize(L["Notif_MarkOneTitle"].Value));
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Theme toggle. The theme is already applied to <html> by the head script;
        // this keeps <body> in sync for scripts that read it (charts, site.js)
        // and emits an event so live charts can recolour without a reload.
        (function () {
            const root    = document.documentElement;
            const body    = document.body;
            const toggles = document.querySelectorAll('.theme-toggle');
            const iconClass = (theme) => theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon';

            function setTheme(theme) {
                root.setAttribute('data-theme', theme);
                root.setAttribute('data-bs-theme', theme);
                body.setAttribute('data-theme', theme);
                try { localStorage.setItem('theme', theme); } catch (e) { /* ignore */ }
                toggles.forEach(t => {
                    const icon = t.querySelector('i');
                    if (icon) icon.className = iconClass(theme);
                    t.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
                });
                document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
            }

            setTheme(root.getAttribute('data-theme') || 'light');
            toggles.forEach(t => t.addEventListener('click', function () {
                setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
            }));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
